# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# ---- 测试与工具缓存 ----
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
Thumbs.db
desktop.ini

# ---- 敏感信息（绝对不能提交！）----
.env
.env.*
*.pem
*.key

# ---- 日志文件 ----
# 注意：这一行会连带忽略 examples/ 里的示例日志，
# 所以下面用 ! 把它"捞"回来 —— 这就是 .gitignore 的例外写法。
*.log
!examples/*.log
